{
    "name": "silvershop-suite/search-typesense",
    "description": "Typesense engine adapter for silvershop-suite/search: typo-tolerant, relevance-ranked product search via a self-hosted Typesense.",
    "type": "silverstripe-vendormodule",
    "keywords": ["silverstripe", "silvershop", "ecommerce", "search", "typesense"],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Remy Vaartjes",
            "email": "remy@xd.nl",
            "role": "Lead developer"
        },
        {
            "name": "SilverShop-Suite Contributors"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6",
        "silvershop/core": "^6.2",
        "silvershop-suite/search": "^1",
        "guzzlehttp/guzzle": "^7"
    },
    "require-dev": {
        "cambis/silverstan": "^2.1",
        "silverstripe/recipe-testing": "^4",
        "silverstripe/sqlite3": "^4",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "stan": "vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=-1",
        "lint": "vendor/bin/phpcs",
        "lint:fix": "vendor/bin/phpcbf"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": false
        }
    },
    "autoload": {
        "psr-4": {
            "SilverShop\\Search\\Typesense\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SilverShop\\Search\\Typesense\\Tests\\": "tests/php/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
